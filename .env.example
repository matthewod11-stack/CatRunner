## Copy to `.env.local` and fill in your values.
## Local env vars are loaded by Vite for dev.

## --- Gemini (server-side) ---
## Required for AI cat generation + wisdom + death messages.
GEMINI_API_KEY=your_gemini_api_key_here

## Model used for generating custom cat sprite images.
## (Leave as-is unless you have a reason to change it.)
GEMINI_IMAGE_MODEL=gemini-2.5-flash-image

## Server-side timeouts (ms) for Gemini requests.
GEMINI_TEXT_TIMEOUT_MS=45000
GEMINI_IMAGE_TIMEOUT_MS=120000

## --- /api/cat/* request guards (server-side + dev middleware) ---
CAT_API_MAX_BODY_BYTES=32768
CAT_API_RATE_GENERATE_PER_MIN=8
CAT_API_RATE_TEXT_PER_MIN=40

## --- Browser fetch tuning (optional) ---
## Override the AbortController timeout (ms) for all browser `fetch` calls to `/api/cat/*`.
## Must be >= 5000 to take effect (otherwise defaults are used).
# VITE_CAT_API_CLIENT_TIMEOUT_MS=55000

